# ============================================================================
# G3DT Configuration — all settings in one place
# Plantilla de configuració per a la instal·lació a Eva (production v1).
# Copiar a `.env` i emplenar valors reals. NO committar `.env` mai.
# ============================================================================

# ============================================================================
# API Keys (REQUIRED) — generar a console.anthropic.com / console.groq.com
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=

# ============================================================================
# Paths — workflow còpia local + copy-back (production v1, 2026-05-04)
# ============================================================================
# Carpeta de projectes a la xarxa de G3DT (origen + destí del .docx final)
# Eva confirmarà la lletra de la unitat (F:, G:, ...) al moment de la instal·lació
G3DT_NETWORK_PROJECTS=F:\projectes

# Còpia local de treball: el pipeline corre aquí, NO toca la xarxa fins al final
G3DT_LOCAL_WORKSPACE=C:\g3dt-ia\workspace

# Informes generats (abans del copy-back a la xarxa)
G3DT_REPORTS_DIR=C:\g3dt-ia\reports

# Cache base per a outputs intermedis (geocode, ICGC, Cadastre, ortho,
# mapillary, Groq...). Si NO es configura, el sistema cau al default
# històric `%USERPROFILE%\.g3dt\cache\` — funciona però pol·lueix el
# perfil de l'usuari Windows. Recomanat: apuntar a la pròpia carpeta neta.
G3DT_CACHE_DIR=C:\g3dt-ia\cache

# ============================================================================
# Vision Models — lectura visual de PDFs (planol, sondeig, DPSH)
# ============================================================================
OPENAI_VISION_MODEL=gpt-4.1-mini
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Llama 4 Scout — validat al demo del 2026-04-30, millors resultats que DeepSeek/Qwen
# Millora futura (v2+): avaluar Llama 4 Maverick en una sessió de benchmark dedicada
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ============================================================================
# Text/LLM Models — FileMiner deep extraction i síntesi
# ============================================================================
GROQ_TEXT_MODEL=qwen/qwen3-32b
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-6
OPENROUTER_ANTHROPIC_TEXT_MODEL=anthropic/claude-sonnet-4.6

# ============================================================================
# Fallback Priority — primer disponible, els altres queden de reserva
# ============================================================================
VISION_FALLBACK=openai,anthropic,groq
PROBE_FALLBACK=groq,openai,anthropic

# ============================================================================
# Logging
# ============================================================================
G3DT_LOG_ENABLED=1
G3DT_LOG_PATH=C:\g3dt-ia\logs\g3dt.log
G3DT_LOG_LEVEL=INFO
G3DT_LOG_DEPTH=FULL
G3DT_LOG_ROTATE_DAILY=1
G3DT_LOG_KEEP_DAYS=30

# ============================================================================
# Feature Flags
# ============================================================================
# Pipeline determinista (Fase 0/0.3/0.4/0.45/0.5 + Fase 1 visió)
G3DT_USE_SMARTSCAN=1
G3DT_USE_GROQ=1
G3DT_ORTHO_ENRICHMENT=1
# G3DT_NO_CACHE=1     # Descomentar per forçar re-extracció (ignora caches)

# AI pipeline experimental (Stages 2-5, Pass A/B/C) — NO activar a producció v1
G3DT_ENABLE_AI_PIPELINE=false

# DEV mode — eines de desenvolupament/diagnòstic al wizard. Producció: false
G3DT_DEV_MODE=false

# Vision via Claude Code subprocess (alternativa a Groq).
# Activar només si Claude Code està instal·lat a l'ordinador d'Eva.
# Per defecte: false (Eva no té Claude Code instal·lat a v1)
G3DT_PROD_USE_CLAUDECODE_VISION=false

# ============================================================================
# HITL wizard drawer + CC-Agentic LLM routing
# ============================================================================
# Provider: anthropic (api.anthropic.com) | openrouter (openrouter.ai/api)
G3DT_LLM_PROVIDER=anthropic

# Primary model per a document extraction (HITL drawer + cc_extractor)
G3DT_CC_MODEL=claude-sonnet-4-6

# Model per al compare_results LLM judge
G3DT_JUDGE_MODEL=claude-sonnet-4-6

# ============================================================================
# Lectura headless amb Claude Code (via A) — el procés mesurat (M341)
# ============================================================================
# Activa els botons «Preparar / Enllestir / Des de zero» del wizard: cada
# document del projecte el llegeix `claude -p` amb el skill g3dt-llegir-projecte,
# i després els dos lectors d'imatges (fotos i figures). Cal el CLI `claude`
# instal·lat i amb sessió iniciada (subscripció claude.ai) a l'ordinador.
# Producció v1 (2026-05-04) el tenia a false; el llançament 2026-09 el posa a true.
G3DT_USE_LECTURA_HEADLESS=false

# Model i esforç del CLI (`--model`, `--effort`). Mesurat: sonnet @ xhigh per als
# documents (0 errors amb confiança a Castellar); els lectors d'imatges van a
# «medium» sempre (fixat al codi). Un altre model/esforç = una altra fila del ledger.
G3DT_LECTURA_MODEL=sonnet
G3DT_LECTURA_EFFORT=xhigh

# login = sessió de claude.ai (es treuen ANTHROPIC_API_KEY/AUTH_TOKEN de l'entorn
# del fill); api_key = paga per crida amb la clau de dalt.
G3DT_LECTURA_AUTH=login

# Camí del binari si no és al PATH (Windows: `claude.cmd` d'npm; WSL: `~/.local/bin/claude`).
# G3DT_CLAUDE_PATH=

# Documents en paral·lel (2 mesurat com a segur en portàtil), topalls per document.
G3DT_LECTURA_CONCURRENCY=2
# G3DT_LECTURA_TIMEOUT=600
# G3DT_LECTURA_TIMEOUT_SLOW=900

# Lectors d'imatges dins el job (una crida per lector i projecte; es repeteixen
# només si el contingut del projecte canvia; mai si l'Eva ja ha triat).
G3DT_LECTURA_IMATGES=true

# ============================================================================
# Avisos del wizard headless (Fase 15, disseny annex §6)
# ============================================================================
# La taula d'estat del wizard és la veritat; això són avisos. Cap canal és
# bloquejant: si falla, es registra un warning i el job acaba igual.
# Un avís per projecte, en acabar o en fallar — mai per pas.

# Toast a l'escriptori (Windows: BurntToast; WSL/dev: notify-send si hi és)
G3DT_NOTIFY_TOAST=true

# SMTP. Remitent DEDICAT (g3dt@ o notificacions@), mai el correu personal.
# Preferència: clau SMTP transaccional de Brevo, revocable i només d'enviament.
G3DT_NOTIFY_SMTP_HOST=
G3DT_NOTIFY_SMTP_PORT=587
G3DT_NOTIFY_SMTP_USER=
G3DT_NOTIFY_SMTP_PASS=
G3DT_NOTIFY_FROM=
# G3DT_NOTIFY_SMTP_STARTTLS=true   # per defecte: sí al port 587, no al 465

# Destinataris. BUIT = canal desactivat (no és un error).
#   TO_EVA        avís d'una línia: l'informe és preparat, prem Enllestir.
#   TO_EFICIENTS  avís tècnic (§6.4): expedient, durades, errors. Mai BCC, mai
#                 valors de camps, mai noms de fitxer. Si G3 no ho vol: buit.
G3DT_NOTIFY_TO_EVA=
G3DT_NOTIFY_TO_EFICIENTS=

# URL que surt al correu de l'Eva
G3DT_NOTIFY_WIZARD_URL=http://localhost:8765/review.html
